{
  "expo": {
    "name": "Markee",
    "slug": "markee",
    "version": "1.0.0",
    "scheme": "markee",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.markee.app"
    },
    "android": {
      "package": "com.markee.app",
      "adaptiveIcon": {
        "backgroundColor": "#FEF4E8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      "expo-sharing",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "O Markee usa a câmera só para ler QR codes de perfis e grupos. Nenhuma imagem é gravada ou enviada.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FEF4E8",
          "dark": {
            "backgroundColor": "#131314"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "01e7e6eb-307d-4696-b27c-f15bb03c3cdd"
      }
    },
    "owner": "brennomarkee"
  }
}
